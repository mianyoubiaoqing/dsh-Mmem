{
  "name": "@mistymoon/dsh-memory",
  "version": "0.0.1-rc.6",
  "description": "Durable companion memory for MistyMoon on DSH",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./contracts": {
      "types": "./lib/contracts.d.ts",
      "default": "./lib/contracts.js"
    },
    "./candidate-extraction": {
      "types": "./lib/candidate-extraction.d.ts",
      "default": "./lib/candidate-extraction.js"
    },
    "./conflict": {
      "types": "./lib/conflict.d.ts",
      "default": "./lib/conflict.js"
    },
    "./retrieval": {
      "types": "./lib/retrieval.d.ts",
      "default": "./lib/retrieval.js"
    },
    "./advanced-retrieval": {
      "types": "./lib/advanced-retrieval.d.ts",
      "default": "./lib/advanced-retrieval.js"
    },
    "./lifecycle": {
      "types": "./lib/lifecycle.d.ts",
      "default": "./lib/lifecycle.js"
    },
    "./domain": {
      "types": "./lib/domain.d.ts",
      "default": "./lib/domain.js"
    },
    "./legacy-migration": {
      "types": "./lib/legacy-migration.d.ts",
      "default": "./lib/legacy-migration.js"
    },
    "./maintenance": {
      "types": "./lib/maintenance.d.ts",
      "default": "./lib/maintenance.js"
    },
    "./runtime-settings": {
      "types": "./lib/runtime-settings.d.ts",
      "default": "./lib/runtime-settings.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.7 <0.1.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.7 <0.1.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7 <0.1.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "@mistymoon/dsh-identity": "workspace:*",
    "@types/proper-lockfile": "4.1.4"
  }
}
