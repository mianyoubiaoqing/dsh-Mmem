{
  "name": "@mistymoon/dsh-mmem",
  "version": "0.0.1-alpha.0",
  "description": "Owner-governed long-term memory bundle for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "main": "./lib/memory/index.js",
  "types": "./lib/memory/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/memory/index.d.ts",
      "default": "./lib/memory/index.js"
    },
    "./contracts": {
      "types": "./lib/memory/contracts.d.ts",
      "default": "./lib/memory/contracts.js"
    },
    "./candidate-extraction": {
      "types": "./lib/memory/candidate-extraction.d.ts",
      "default": "./lib/memory/candidate-extraction.js"
    },
    "./conflict": {
      "types": "./lib/memory/conflict.d.ts",
      "default": "./lib/memory/conflict.js"
    },
    "./retrieval": {
      "types": "./lib/memory/retrieval.d.ts",
      "default": "./lib/memory/retrieval.js"
    },
    "./advanced-retrieval": {
      "types": "./lib/memory/advanced-retrieval.d.ts",
      "default": "./lib/memory/advanced-retrieval.js"
    },
    "./lifecycle": {
      "types": "./lib/memory/lifecycle.d.ts",
      "default": "./lib/memory/lifecycle.js"
    },
    "./domain": {
      "types": "./lib/memory/domain.d.ts",
      "default": "./lib/memory/domain.js"
    },
    "./legacy-migration": {
      "types": "./lib/memory/legacy-migration.d.ts",
      "default": "./lib/memory/legacy-migration.js"
    },
    "./maintenance": {
      "types": "./lib/memory/maintenance.d.ts",
      "default": "./lib/memory/maintenance.js"
    },
    "./runtime-settings": {
      "types": "./lib/memory/runtime-settings.d.ts",
      "default": "./lib/memory/runtime-settings.js"
    },
    "./space-catalog": {
      "types": "./lib/memory/space-catalog.d.ts",
      "default": "./lib/memory/space-catalog.js"
    },
    "./space-archive-router": {
      "types": "./lib/memory/space-archive-router.d.ts",
      "default": "./lib/memory/space-archive-router.js"
    },
    "./settings-host": {
      "types": "./lib/memory/settings-host.d.ts",
      "default": "./lib/memory/settings-host.js"
    },
    "./settings-client": {
      "types": "./lib/memory/settings-client.d.ts",
      "default": "./lib/memory/settings-client.js"
    },
    "./identity-compat": {
      "types": "./lib/identity/index.d.ts",
      "default": "./lib/identity/index.js"
    },
    "./settings-ui": {
      "types": "./lib/settings-ui/index.d.ts",
      "default": "./lib/settings-ui/index.js"
    },
    "./settings-ui/client": "./lib/settings-ui/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mianyoubiaoqing/dsh-Mmem.git",
    "directory": "packages/bundle"
  },
  "homepage": "https://github.com/mianyoubiaoqing/dsh-Mmem#readme",
  "bugs": {
    "url": "https://github.com/mianyoubiaoqing/dsh-Mmem/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "memory",
    "long-term-memory"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "proper-lockfile": "4.1.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.7 <0.1.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.7 <0.1.0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.7 <0.1.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7 <0.1.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
